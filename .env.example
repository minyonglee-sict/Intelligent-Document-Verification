# docker-compose.yml 이 읽는 값. 이 파일을 .env 로 복사하고 실제 값을 채운다.
#   cp .env.example .env
# .env 는 .gitignore 에 있어 커밋되지 않는다 -- .smtp_credentials 와 같은 원칙이다.

# 컨테이너 MS SQL Server의 sa 비밀번호. 대문자·소문자·숫자·특수문자를 섞어 8자 이상
# (MS SQL 자체 정책 -- 안 그러면 mssql 컨테이너가 뜨자마자 죽는다).
MSSQL_SA_PASSWORD=Change_Me_123!

# 비밀번호 재설정 메일 발송용 (없으면 그 기능만 꺼진 채로 나머지는 정상 동작한다).
# Gmail 이면 계정 비밀번호가 아니라 "앱 비밀번호"를 쓴다.
SMTP_USER=
SMTP_PASSWORD=
ADMIN_CONTACT_EMAIL=
